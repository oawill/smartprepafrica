generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Identity & roles ----------

enum Role {
  STUDENT
  PARENT
  SCHOOL_ADMIN
  TEACHER
  SPONSOR
  PARTNER
  ADMIN
}

// ---------- Unified Admin Portal: RBAC & account security ----------

// Only meaningful when Role = ADMIN. Null on an ADMIN user means "not yet
// assigned a sub-role" (treated as no permissions until a Super Admin sets one).
enum AdminRole {
  SUPER_ADMIN
  PLATFORM_ADMIN
  CONTENT_ADMIN
  CONTENT_REVIEWER
  SCHOOL_SUPPORT_ADMIN
  USER_SUPPORT_ADMIN
  FINANCE_ADMIN
  PARTNER_ADMIN
  SECURITY_ADMIN
  ANALYST
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  LOCKED
  PENDING_VERIFICATION
  CLOSED
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String?
  name         String
  role         Role     @default(STUDENT)
  avatarUrl    String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Only set (and only meaningful) when role = ADMIN. Governs fine-grained
  // permissions via src/lib/admin/permissions.ts — assignable only by a
  // Super Admin (see src/app/dashboard/admin/admins).
  adminRole AdminRole?

  // Account security state, applicable to any role. Suspending/locking a
  // user does not delete any of their data.
  status            AccountStatus @default(ACTIVE)
  statusReason      String?
  // Bare id reference (no FK), same pattern as Partner.approvedById — the
  // actor who last changed this account's status.
  statusChangedById String?
  statusChangedAt   DateTime?

  // Bumped to force sign-out on every device: the jwt callback compares the
  // token's embedded version against this column on each request and
  // rejects stale tokens. This is how "revoke session" works without a
  // database session strategy.
  sessionVersion Int @default(0)

  // Permanent human-readable reference, e.g. STU-00012345. Only assigned to
  // STUDENT accounts (see src/lib/admin/ids.ts), lazily backfilled for
  // accounts that existed before this field was added.
  studentNumber String? @unique

  studentProfile StudentProfile?
  parentLinks    ParentStudentLink[] @relation("ParentLinks")
  schoolAdminOf  School[]            @relation("SchoolAdmins")
  teacherProfile TeacherProfile?
  sponsorProfile SponsorProfile?

  // Every role this user is entitled to hold — `role` above is always one
  // member of this set (the currently active workspace). Most users have
  // exactly one row here; a second row is what makes the "Switch Workspace"
  // UI appear at all.
  roles UserRole[]

  enrollments               CourseEnrollment[]
  examAttempts              ExamAttempt[]
  certificates              Certificate[]
  badges                    UserBadge[]
  subscriptions             Subscription[]
  purchasedSubscriptions    Subscription[]             @relation("PurchasedSubscriptions")
  payments                  Payment[]
  assignmentSubmissions     AssignmentSubmission[]
  teacherFollows            TeacherFollow[]
  courseReviews             CourseReview[]
  lessonCheckpointResponses LessonCheckpointResponse[]

  aiConversations AiConversation[]
  topicMastery    StudentTopicMastery[]
  aiInsights      AiLearningInsight[]
  aiUsageLogs     AiUsageLog[]

  referralsSent    Referral[] @relation("Referrer")
  referralReceived Referral?  @relation("Referred")

  createdVouchers  Voucher[]           @relation("VoucherIssuer")
  redeemedVouchers VoucherRedemption[]

  legalAcceptances           LegalAcceptance[]
  contactSubmissions         ContactSubmission[] @relation("ContactSubmitter")
  assignedContactSubmissions ContactSubmission[] @relation("ContactAssignee")

  notifications Notification[]

  // Set when this user IS an approved partner (role=PARTNER).
  partnerProfile Partner?

  // Set ONCE at registration time by the attribution service, from a valid
  // partner referral click/code. Never editable afterward by any user-facing
  // action — the only writer is the registration transaction itself.
  referredByPartner    Partner?         @relation("PartnerReferredUsers", fields: [referredByPartnerId], references: [id])
  referredByPartnerId  String?
  referredByCampaign   PartnerCampaign? @relation(fields: [referredByCampaignId], references: [id])
  referredByCampaignId String?
  referralCapturedAt   DateTime?

  // The specific click record this registration fulfilled, if any.
  partnerReferralClick PartnerReferral? @relation("ReferralClickUser")

  partnerCommissionsAsSource PartnerCommission[] @relation("CommissionSourceUser")
  partnerAuditActions        PartnerAuditLog[]   @relation("AuditActor")

  adminAuditActions  AuditLog[]          @relation("AdminAuditActor")
  loginActivity      LoginActivity[]     @relation("LoginActivityUser")
  videoProjects      VideoProject[]
  videoRenderJobs    VideoRenderJob[]
  youtubeConnections YouTubeConnection[]
  toeflAttempts      ToeflAttempt[]
  satAttempts        SatAttempt[]
  satScoreGoal       SatScoreGoal?
  internationalExamPurchases InternationalExamPurchase[]

  // The user's country preference, set at registration. Nullable/backfilled
  // to Nigeria for pre-existing accounts — see scripts/backfill-country-refs.ts.
  country   Country? @relation(fields: [countryId], references: [id])
  countryId String?

  @@index([status])
  @@index([role])
}

// Records that a user is entitled to a given role, distinct from
// User.role (the currently *active* one). Admin-granted only — see
// grantAdditionalRole in src/app/dashboard/admin/actions.ts — never
// self-service, since holding a second role is a real-world fact
// (a teacher who is also a parent) that an admin confirms, not something
// a user can claim for themselves.
model UserRole {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      Role
  createdAt DateTime @default(now())

  @@unique([userId, role])
}

model StudentProfile {
  id             String              @id @default(cuid())
  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String              @unique
  school         School?             @relation(fields: [schoolId], references: [id])
  schoolId       String?
  class          Class?              @relation(fields: [classId], references: [id])
  classId        String?
  gradeLevel     String?
  targetExams    ExamType[]
  // Collected at registration when the student's country offers real
  // subject content (see CountryExamSubject) — optional, never forced.
  targetSubjects Subject[]           @relation("StudentTargetSubjects")
  // Non-sequential (unlike User.studentNumber), shown to the student to share
  // with a parent/guardian — deliberately not enumerable since it grants
  // access to this student's academic data once linked.
  linkCode       String?             @unique
  parentLinks    ParentStudentLink[] @relation("StudentLinks")
}

enum ParentLinkStatus {
  PENDING
  ACTIVE
  REJECTED
  REMOVED
}

model ParentStudentLink {
  id        String         @id @default(cuid())
  parent    User           @relation("ParentLinks", fields: [parentId], references: [id], onDelete: Cascade)
  parentId  String
  student   StudentProfile @relation("StudentLinks", fields: [studentId], references: [id], onDelete: Cascade)
  studentId String

  status       ParentLinkStatus @default(PENDING)
  relationship String?

  requestedAt DateTime  @default(now())
  respondedAt DateTime?
  removedAt   DateTime?

  createdAt DateTime @default(now())

  @@unique([parentId, studentId])
  @@index([studentId, status])
}

enum SchoolInviteRole {
  TEACHER
  STUDENT
}

enum SchoolInviteStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  REVOKED
}

// A school inviting its own staff/student, distinct from PartnerSchoolLead
// (a partner recruiting a brand-new school onto the platform) — different
// domain and lifecycle, so kept as a separate model rather than widening
// that one.
model SchoolInvitation {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  inviteeEmail String
  role         SchoolInviteRole

  // Only meaningful when role = STUDENT.
  class   Class?  @relation(fields: [classId], references: [id])
  classId String?

  status              SchoolInviteStatus @default(PENDING)
  invitationToken     String             @unique
  invitationExpiresAt DateTime

  invitedById String
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, inviteeEmail, status])
  @@index([inviteeEmail, status])
}

model School {
  id                String             @id @default(cuid())
  name              String
  address           String?
  // Plain string for now (Nigeria-only marketplace) rather than a full
  // countries/states relation — easy to migrate to a relation later if
  // Educom expands beyond Nigeria.
  state             String?
  country           String             @default("Nigeria")
  // Relational counterpart to the free-text `country` string above, added
  // for the multi-country architecture — nullable, backfilled to Nigeria for
  // every existing row (see scripts/backfill-country-refs.ts). The string
  // field is left as-is/unused-by-new-code rather than removed.
  countryRef        Country?           @relation(fields: [countryId], references: [id])
  countryId         String?
  logoUrl           String?
  coverImageUrl     String?
  description       String?
  verified          Boolean            @default(false)
  // Permanent human-readable reference, e.g. SCH-000045. Backfilled for
  // schools that existed before this field was added.
  schoolNumber      String?            @unique
  status            SchoolStatus       @default(PENDING)
  statusReason      String?
  statusChangedById String?
  statusChangedAt   DateTime?
  admins            User[]             @relation("SchoolAdmins")
  students          StudentProfile[]
  teachers          TeacherProfile[]
  classes           Class[]
  courses           Course[]
  invitations       SchoolInvitation[]
  createdAt         DateTime           @default(now())

  sponsorshipPrograms SponsorshipProgram[]

  // A school may be pursued by multiple partners before it registers; only
  // one of these leads (if any) becomes the authoritative attribution.
  partnerSchoolLeads    PartnerSchoolLead[]
  partnerAttribution    PartnerSchoolAttribution?
  partnerSchoolDisputes PartnerSchoolDispute[]

  @@index([status])
}

enum SchoolStatus {
  PENDING
  VERIFICATION_REQUIRED
  ACTIVE
  SUSPENDED
  CLOSED
}

model TeacherProfile {
  id              String  @id @default(cuid())
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String  @unique
  school          School? @relation(fields: [schoolId], references: [id])
  schoolId        String?
  bio             String?
  photoUrl        String?
  qualifications  String?
  yearsExperience Int?

  classes   Class[]         @relation("TeacherClasses")
  courses   Course[]
  followers TeacherFollow[]
}

model TeacherFollow {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  teacher   TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Cascade)
  teacherId String
  createdAt DateTime       @default(now())

  @@unique([userId, teacherId])
}

model Class {
  id        String   @id @default(cuid())
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId  String
  name      String
  createdAt DateTime @default(now())

  teachers TeacherProfile[] @relation("TeacherClasses")
  students StudentProfile[]

  invitations       SchoolInvitation[]
  courseAssignments ClassCourseAssignment[]
}

// A school curating which of its own courses a cohort should study.
// Assigning a course auto-enrolls the class's current students
// (CourseEnrollment); unassigning only removes the curation link and never
// touches those enrollments, so a student's progress is never lost by an
// admin changing what's currently assigned to their class.
model ClassCourseAssignment {
  id           String   @id @default(cuid())
  class        Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  classId      String
  course       Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  assignedById String
  assignedAt   DateTime @default(now())

  @@unique([classId, courseId])
}

model SponsorProfile {
  id           String    @id @default(cuid())
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String    @unique
  organization String?
  vouchers     Voucher[]

  programs SponsorshipProgram[]
}

// ---------- Multi-country expansion ----------
// Phase 1 (foundation): additive only — Nigeria stays the sole ACTIVE
// country and the existing ExamType enum / Subject model are untouched, so
// every existing flow keeps working unchanged. See scripts/seed-countries.ts
// and scripts/backfill-country-refs.ts for how existing rows get scoped to
// Nigeria, and CountryStatus for the per-country activation gate.

enum CountryStatus {
  DRAFT
  CONTENT_SETUP
  TESTING
  ACTIVE
  PAUSED
}

model Country {
  id              String        @id @default(cuid())
  name            String        @unique
  code            String        @unique // ISO 3166-1 alpha-2, e.g. "NG"
  currency        String // "NGN"
  currencySymbol  String // "₦"
  flag            String // emoji, e.g. "🇳🇬" — no asset pipeline needed
  status          CountryStatus @default(DRAFT)
  defaultLanguage String        @default("en")
  timezone        String // e.g. "Africa/Lagos"
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  users             User[]
  schools           School[]
  partners          Partner[]
  countryExams      CountryExam[]
  countryPlanPrices CountryPlanPrice[]

  @@index([status])
}

model ExamBody {
  id        String   @id @default(cuid())
  name      String   @unique // "WAEC", "JAMB", "NECO"
  code      String   @unique
  exams     Exam[]
  createdAt DateTime @default(now())
}

// The abstract exam PRODUCT (WASSCE, UTME, Post-UTME, SSCE) — a single
// global definition administered by one ExamBody. Country-specific
// availability/activation lives on CountryExam, not here, so the same
// WASSCE row is shared by Nigeria, Ghana, Sierra Leone, Liberia and The
// Gambia without duplication.
model Exam {
  id           String        @id @default(cuid())
  name         String // "WASSCE"
  code         String        @unique // "WASSCE"
  examBody     ExamBody      @relation(fields: [examBodyId], references: [id])
  examBodyId   String
  countryExams CountryExam[]
  createdAt    DateTime      @default(now())

  @@index([examBodyId])
}

// Answers "is this exam offered in this country, and is it live yet?" — the
// feature-flag join Admin uses to activate a country's exam in phases
// (Draft -> Content Setup -> Testing -> Active -> Paused) without exposing
// it publicly beforehand.
model CountryExam {
  id        String        @id @default(cuid())
  country   Country       @relation(fields: [countryId], references: [id])
  countryId String
  exam      Exam          @relation(fields: [examId], references: [id])
  examId    String
  status    CountryStatus @default(DRAFT)
  createdAt DateTime      @default(now())

  subjects      CountryExamSubject[]
  questions     Question[]
  passageGroups PassageGroup[]
  videoProjects VideoProject[]

  @@unique([countryId, examId])
  @@index([status])
}

// Which of the (already-global) Subjects are offered for a given country's
// exam, e.g. Ghana/WASSCE offering "Biology" reuses the same Subject row
// Nigeria/WASSCE uses rather than duplicating it.
model CountryExamSubject {
  id            String      @id @default(cuid())
  countryExam   CountryExam @relation(fields: [countryExamId], references: [id])
  countryExamId String
  subject       Subject     @relation(fields: [subjectId], references: [id])
  subjectId     String
  topics        ExamTopic[]

  @@unique([countryExamId, subjectId])
}

// Lightweight syllabus topic scoped to one country's exam+subject, so e.g.
// Ghana's WASSCE Biology syllabus can diverge from Nigeria's even though the
// Subject row is shared. Purely additive — existing Question.topic/subtopic
// free-text fields are untouched; this is opt-in for new content.
model ExamTopic {
  id                   String             @id @default(cuid())
  countryExamSubject   CountryExamSubject @relation(fields: [countryExamSubjectId], references: [id])
  countryExamSubjectId String
  name                 String
  order                Int                @default(0)
  questions            Question[]
  videoProjects        VideoProject[]

  @@index([countryExamSubjectId])
}

// Dormant until wired into checkout in a later phase — lets Admin configure
// a plan's price for a country ahead of that country's launch, without
// touching the live Nigeria Paystack checkout path.
model CountryPlanPrice {
  id         String           @id @default(cuid())
  country    Country          @relation(fields: [countryId], references: [id])
  countryId  String
  plan       SubscriptionPlan
  priceMinor Int // minor currency unit (kobo/pesewas/cents)
  currency   String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([countryId, plan])
}

// ---------- Video Learning Studio (VLS) ----------
// Phase 1: curriculum-linked project creation + real AI script/scene
// generation + review workflow. No rendering, voice, storage, or YouTube
// integration yet — those need infrastructure this app doesn't have today
// (see VideoProjectStatus values beyond SCRIPT_APPROVED, reserved but
// unused until later phases).

enum VideoProjectStatus {
  DRAFT
  SCRIPT_GENERATING
  SCRIPT_READY
  NEEDS_REVIEW
  SCRIPT_APPROVED
  ASSETS_GENERATING
  VOICE_GENERATING
  READY_TO_RENDER
  RENDERING
  RENDER_COMPLETE
  RENDER_FAILED
  FINAL_REVIEW
  APPROVED
  READY_TO_PUBLISH
  PUBLISHED
  ARCHIVED
}

enum VideoType {
  FULL_LESSON
  QUICK_REVISION
  PAST_QUESTION_WALKTHROUGH
  CONCEPT_EXPLAINER
  WORKED_EXAMPLE
  PRACTICAL_DEMONSTRATION
  EXAM_TIPS
  TOPIC_SUMMARY
  YOUTUBE_SHORT
  REVISION_SHORT
}

enum VideoAspectRatio {
  LANDSCAPE_16_9
  VERTICAL_9_16
  SQUARE_1_1
}

enum VideoSceneType {
  HOOK
  BRAND_INTRO
  LEARNING_OBJECTIVE
  CONCEPT
  DEFINITION
  EXAMPLE
  WORKED_EXAMPLE
  EQUATION
  DIAGRAM
  ANIMATION
  COMPARISON
  EXAM_TIP
  WAEC_QUESTION
  MULTIPLE_CHOICE
  QUESTION_TIMER
  ANSWER_REVEAL
  SUMMARY
  CALL_TO_ACTION
  OUTRO
}

enum VideoSceneReviewStatus {
  PENDING
  FLAGGED
  APPROVED
}

// A scene's question can come from the real question bank (already
// published SmartPrepAfrica content, no extra review needed) or be an AI
// draft that must never touch the Question table until an admin approves
// it into the real bank through the existing question-review workflow.
enum VideoSceneQuestionSource {
  NONE
  EXISTING_QUESTION
  AI_DRAFT
}

// The top-level production unit. Deliberately not scoped to any one
// subject — countryExamId + subjectId + topic is the same generic
// curriculum link every other exam-content model in this app uses.
model VideoProject {
  id          String  @id @default(cuid())
  title       String
  description String?

  countryExam   CountryExam @relation(fields: [countryExamId], references: [id])
  countryExamId String
  subject       Subject     @relation(fields: [subjectId], references: [id])
  subjectId     String
  // Plain string, matching Question.topic/Lesson.topic — the load-bearing
  // convention this codebase repeatedly protects. ExamTopic has real rows
  // only where seeded; link to it opportunistically, never require it.
  topic         String
  examTopic     ExamTopic?  @relation(fields: [examTopicId], references: [id])
  examTopicId   String?
  gradeLevel    String? // e.g. "SS3" — matches Question.grade / StudentProfile.gradeLevel

  videoType         VideoType
  aspectRatio       VideoAspectRatio @default(LANDSCAPE_16_9)
  targetDurationSec Int
  language          String           @default("English")

  learningObjectives String[] @default([])

  status VideoProjectStatus @default(DRAFT)

  // Conversion-loop attribution — configurable now, not wired to a real
  // analytics pipeline until the YouTube/publish phases exist.
  ctaLabel       String?
  ctaDestination String?
  campaignId     String?

  // YouTube distribution (Phase 4). youtubePrivacyStatus is recorded at
  // upload time, not editable in-app yet — changing visibility happens in
  // YouTube Studio until a later phase adds an in-app control.
  youtubeVideoId       String?
  youtubeUploadStatus  YouTubeUploadStatus @default(NOT_STARTED)
  youtubeUploadError   String?
  youtubePrivacyStatus String?
  youtubePublishedAt   DateTime?

  createdBy   User     @relation(fields: [createdById], references: [id])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scenes         VideoScene[]
  generationLogs VideoGenerationLog[]
  renderJobs     VideoRenderJob[]

  @@index([status])
  @@index([subjectId])
  @@index([countryExamId])
}

model VideoScene {
  id        String       @id @default(cuid())
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  order                Int
  sceneType            VideoSceneType
  title                String
  estimatedDurationSec Int            @default(15)

  narration             String?
  onScreenText          String?
  visualDirection       String?
  animationInstructions String?
  learningObjective     String?

  // Scientific/mathematical notation as plain source text (e.g.
  // "HCl + NaOH -> NaCl + H_2O"), rendered with KaTeX at display time —
  // never stored pre-rendered.
  equation           String?
  diagramDescription String?

  questionSource           VideoSceneQuestionSource @default(NONE)
  question                 Question?                @relation(fields: [questionId], references: [id])
  questionId               String?
  draftQuestionPrompt      String?
  draftQuestionOptions     Json?
  draftQuestionAnswer      String?
  draftQuestionExplanation String?

  reviewStatus VideoSceneReviewStatus @default(PENDING)
  reviewNotes  String?

  // Generated narration audio (Phase 2). voiceAudioUrl points at Vercel
  // Blob storage — this app has no other file storage, so this is also
  // the first real asset URL in VLS that isn't a placeholder.
  voiceStatus      VideoSceneVoiceStatus @default(NOT_STARTED)
  voiceAudioUrl    String?
  voiceDurationSec Float?
  voiceProvider    String?
  voiceId          String?
  voiceError       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, order])
  @@index([projectId])
}

enum VideoSceneVoiceStatus {
  NOT_STARTED
  GENERATING
  READY
  FAILED
}

// Reusable, project-independent pronunciation corrections for scientific/
// technical terms TTS providers commonly mispronounce — applied as a
// find/replace pass on narration text immediately before it's sent to the
// voice provider, never stored back onto the scene.
model VoicePronunciationOverride {
  id                String   @id @default(cuid())
  displayText       String   @unique
  pronunciationText String
  phoneme           String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Mirrors AiUsageLog's intent but scoped to video generation, whose cost
// shape (script tokens today; TTS/image/render usage later) doesn't fit
// AiUsageLog's coach-specific fields. Also the real data backing the
// Production Queue in Phase 1, since script generation is the only
// async-ish operation that exists yet.
model VideoGenerationLog {
  id        String       @id @default(cuid())
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  stage        String // "SCRIPT_GENERATION" | "OBJECTIVES_SUGGESTION" | "SCENE_REGENERATION" | "QUESTION_GENERATION" | "VOICE_GENERATION"
  provider     String  @default("anthropic")
  model        String
  status       String // "SUCCEEDED" | "FAILED"
  errorMessage String?

  inputTokens       Int  @default(0)
  outputTokens      Int  @default(0)
  // TTS jobs are billed per character, not per token — inputTokens/
  // outputTokens stay 0 for those rows rather than being repurposed.
  characterCount    Int?
  estimatedCostKobo Int  @default(0)

  startedAt   DateTime  @default(now())
  completedAt DateTime?

  @@index([projectId, startedAt])
  @@index([status])
}

enum RenderJobStatus {
  QUEUED
  RENDERING
  COMPLETE
  FAILED
  CANCELLED
}

// The real render job queue (brief section 29/38) — deliberately built
// ahead of any actual worker existing. A worker, wherever it eventually
// runs, reports progress back via POST /api/video-studio/render-jobs/[id]/
// callback rather than needing direct database access, so it can live
// completely outside this app's deployment (Lambda, a separate container,
// anywhere).
model VideoRenderJob {
  id        String       @id @default(cuid())
  project   VideoProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  status          RenderJobStatus @default(QUEUED)
  progressPercent Int             @default(0)

  outputUrl         String?
  outputDurationSec Float?
  errorMessage      String?
  retryCount        Int     @default(0)

  // Remotion Lambda's own render identifiers, stored purely for operator
  // traceability (e.g. cross-referencing AWS Lambda/S3 consoles) — the
  // webhook that reports completion looks the job up via a `jobId` it
  // passed as customData at trigger time, not via these.
  remotionRenderId   String?
  remotionBucketName String?

  requestedBy   User   @relation(fields: [requestedById], references: [id])
  requestedById String

  queuedAt    DateTime  @default(now())
  startedAt   DateTime?
  completedAt DateTime?

  @@index([projectId, queuedAt])
  @@index([status])
}

enum YouTubeUploadStatus {
  NOT_STARTED
  UPLOADING
  UPLOADED
  FAILED
}

// Singleton by convention (one shared SmartPrepAfrica channel, not
// per-admin) — the connect callback deletes any existing row before
// creating the new one, so there is only ever at most one of these.
model YouTubeConnection {
  id                    String  @id @default(cuid())
  channelId             String  @unique
  channelTitle          String
  channelThumbnailUrl   String?
  refreshTokenEncrypted String
  scope                 String

  connectedBy   User   @relation(fields: [connectedById], references: [id])
  connectedById String

  connectedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

// ---------- Exam prep ----------

enum ExamType {
  WAEC
  NECO
  UTME
  POST_UTME
}

model Subject {
  id                  String               @id @default(cuid())
  name                String               @unique
  questions           Question[]
  passageGroups       PassageGroup[]
  examAttempts        ExamAttempt[]
  courses             Course[]
  sponsorshipPrograms SponsorshipProgram[]
  countryExamSubjects CountryExamSubject[]
  targetedByStudents  StudentProfile[]     @relation("StudentTargetSubjects")
  videoProjects       VideoProject[]

  aiConversations AiConversation[]
  topicMastery    StudentTopicMastery[]
  aiInsights      AiLearningInsight[]
}

model Question {
  id            String     @id @default(cuid())
  exam          ExamType
  subject       Subject    @relation(fields: [subjectId], references: [id])
  subjectId     String
  topic         String?
  subtopic      String?
  grade         String?
  year          Int?
  difficulty    Difficulty @default(MEDIUM)
  prompt        String
  imageUrl      String?
  options       Json // [{ key: "A", text: "..." }, ...]
  correctOption String
  explanation   String?
  createdAt     DateTime   @default(now())

  // Permanent human-readable reference, e.g. QUE-00098765. Backfilled for
  // rows that existed before this field was added.
  questionNumber String? @unique

  // Existing seeded/legacy questions default to PUBLISHED so nothing that
  // already worked stops working; new questions created through the admin
  // portal are created explicitly as DRAFT and must go through review.
  status     QuestionStatus     @default(PUBLISHED)
  sourceType QuestionSourceType @default(ORIGINAL_SMARTPREP_QUESTION)

  // Bare id references (no FK), same pattern as Partner.approvedById.
  createdById  String?
  reviewedById String?
  reviewedAt   DateTime?

  // Set when another question was flagged as a likely duplicate of this one
  // during bulk import or manual save. Never auto-deleted — a reviewer
  // decides.
  duplicateOfId String?

  // Optional membership in a shared reading passage (English Comprehension /
  // Literature). Null means a fully standalone question — every existing
  // question and every non-English exam stays on this path unchanged.
  passageGroup     PassageGroup? @relation(fields: [passageGroupId], references: [id])
  passageGroupId   String?
  passageOrder     Int? // position within the passage group (count-then-create)
  passageLineRef   String? // freeform anchor, e.g. "Stanza 2" / "Act I, Scene 1"
  passageLineStart Int? // numeric line anchor for auto-highlight/scroll
  passageLineEnd   Int?

  // Optional richer scope for the multi-country architecture — null for
  // every existing question and for any new Nigeria question that doesn't
  // need it; `exam`/`subjectId`/`topic` above remain the required, always-set
  // fields every consumer already relies on.
  countryExam   CountryExam? @relation(fields: [countryExamId], references: [id])
  countryExamId String?
  examTopic     ExamTopic?   @relation(fields: [examTopicId], references: [id])
  examTopicId   String?

  responses   QuestionResponse[]
  videoScenes VideoScene[]

  @@index([status])
  @@index([subjectId])
  @@index([exam])
  @@index([passageGroupId])
  @@index([countryExamId])
}

enum PassageType {
  COMPREHENSION
  PROSE_EXTRACT
  POETRY
  DRAMA_EXTRACT
  DIALOGUE
  LITERARY_EXTRACT
  OTHER
}

// A shared reading passage/poem/extract that multiple Questions attach to.
// Reuses QuestionStatus/QuestionSourceType so the admin review workflow
// (draft -> review -> approve -> publish -> archive) and its existing
// permission checks / bulk-action patterns apply here unchanged.
model PassageGroup {
  id                 String             @id @default(cuid())
  exam               ExamType
  subject            Subject            @relation(fields: [subjectId], references: [id])
  subjectId          String
  code               String?            @unique // human-readable, e.g. PSG-000123
  type               PassageType        @default(COMPREHENSION)
  title              String?
  instructions       String?
  bodyText           String
  showLineNumbers    Boolean            @default(false)
  startingLineNumber Int                @default(1)
  status             QuestionStatus     @default(DRAFT)
  sourceType         QuestionSourceType @default(ORIGINAL_SMARTPREP_QUESTION)
  createdById        String?
  createdAt          DateTime           @default(now())

  // Optional richer scope, same non-destructive pattern as Question above.
  countryExam   CountryExam? @relation(fields: [countryExamId], references: [id])
  countryExamId String?

  questions Question[]

  @@index([status])
  @@index([subjectId])
  @@index([exam])
  @@index([countryExamId])
}

enum QuestionStatus {
  DRAFT
  NEEDS_REVIEW
  APPROVED
  PUBLISHED
  ARCHIVED
}

enum QuestionSourceType {
  OFFICIAL_PAST_QUESTION
  LICENSED_QUESTION
  ORIGINAL_SMARTPREP_QUESTION
  TEACHER_CREATED
  AI_GENERATED
  IMPORTED
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum AttemptMode {
  STUDY_DRILL
  MOCK_EXAM
  CBT_PRACTICE
}

model ExamAttempt {
  id          String      @id @default(cuid())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  exam        ExamType
  mode        AttemptMode
  subjects    Subject[]
  startedAt   DateTime    @default(now())
  submittedAt DateTime?
  score       Float?
  totalItems  Int         @default(0)

  responses QuestionResponse[]
}

model QuestionResponse {
  id             String      @id @default(cuid())
  attempt        ExamAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId      String
  question       Question    @relation(fields: [questionId], references: [id])
  questionId     String
  order          Int         @default(0)
  selectedOption String?
  isCorrect      Boolean?
  timeSpentSecs  Int?
  flagged        Boolean     @default(false)

  @@unique([attemptId, questionId])
}

// ---------- EduCom (learning ecosystem) ----------

enum CourseCategory {
  ACADEMIC
  CAREER_DEVELOPMENT
  TECHNOLOGY
  AI
  CODING
  FINANCIAL_LITERACY
  COMMUNICATION
  LEADERSHIP
  MINDSET
  DISCIPLINE
  LIFE_SKILLS
}

enum CourseModerationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  PUBLISHED
  REJECTED
  NEEDS_CHANGES
  SUSPENDED
}

// ---------- Curriculum hierarchy (Curriculum -> ClassLevel -> Course -> CourseTopic -> Lesson) ----------
// Distinct from the existing plain-string Lesson.topic/Question.topic
// convention (which stays untouched, since it's the key StudentTopicMastery
// and the practice-question cross-link both rely on). This hierarchy is
// purely organizational/browsable metadata layered on top.

model Curriculum {
  id          String   @id @default(cuid())
  name        String   @unique
  code        String   @unique
  country     String   @default("Nigeria")
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  classLevels ClassLevel[]
}

model ClassLevel {
  id           String     @id @default(cuid())
  curriculum   Curriculum @relation(fields: [curriculumId], references: [id], onDelete: Cascade)
  curriculumId String
  name         String
  code         String?
  order        Int
  isActive     Boolean    @default(true)

  courses Course[]

  @@unique([curriculumId, name])
}

model Course {
  id            String         @id @default(cuid())
  title         String
  description   String
  category      CourseCategory
  partnerSchool String?
  coverImageUrl String?
  published     Boolean        @default(false)
  createdAt     DateTime       @default(now())

  // Moderation workflow, layered on top of the existing `published` gate
  // (which remains the actual visibility switch so nothing regresses).
  // Legacy rows default to DRAFT here and are backfilled from `published`
  // right after this column is added.
  moderationStatus CourseModerationStatus @default(DRAFT)
  moderationReason String?
  moderatedById    String?
  moderatedAt      DateTime?
  featured         Boolean                @default(false)

  instructorName     String?
  difficulty         Difficulty?
  estimatedMinutes   Int?
  learningObjectives String[]
  // In kobo; null or 0 means free.
  priceKobo          Int?

  // Set when this course belongs to the "Core Secondary School" or "Exam
  // Preparation" catalog sections rather than the general "Skills" one.
  subject   Subject?  @relation(fields: [subjectId], references: [id])
  subjectId String?
  examType  ExamType?

  // Curriculum browsing metadata (e.g. "SS2"). Optional so Skills-category
  // courses and any course created before this field existed are unaffected.
  classLevel   ClassLevel? @relation(fields: [classLevelId], references: [id])
  classLevelId String?

  // Set when a school or teacher created this course on-platform, as
  // opposed to a centrally seeded/curated course (both stay null for those).
  school    School?         @relation(fields: [schoolId], references: [id])
  schoolId  String?
  teacher   TeacherProfile? @relation(fields: [teacherId], references: [id])
  teacherId String?

  modules      Module[]
  courseTopics CourseTopic[]
  enrollments  CourseEnrollment[]
  certificates Certificate[]
  assignments  Assignment[]
  reviews      CourseReview[]
  liveClasses  LiveClass[]

  aiConversations  AiConversation[]
  classAssignments ClassCourseAssignment[]
}

model CourseReview {
  id        String   @id @default(cuid())
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  @@unique([courseId, userId])
}

model LiveClass {
  id              String   @id @default(cuid())
  course          Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId        String
  title           String
  scheduledAt     DateTime
  durationMinutes Int
  meetingUrl      String
  createdAt       DateTime @default(now())
}

model Module {
  id       String @id @default(cuid())
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  title    String
  order    Int

  lessons Lesson[]
}

// Course -> Topic -> Lesson pedagogical grouping (e.g. "Acids, Bases & Salts"
// containing one or more lessons). Purely organizational browse/admin
// metadata, distinct from Module (unchanged structural/authoring unit) and
// from the plain-string Lesson.topic mastery-key convention below.
model CourseTopic {
  id          String   @id @default(cuid())
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  title       String
  order       Int
  description String?
  createdAt   DateTime @default(now())

  lessons Lesson[]

  @@unique([courseId, order])
}

enum LessonType {
  VIDEO
  TEXT
  QUIZ
}

model Lesson {
  id       String     @id @default(cuid())
  module   Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  moduleId String
  title    String
  type     LessonType
  content  String?
  videoUrl String?
  order    Int
  // Matches Question.topic for the same subject, letting this lesson link
  // to SmartPrepAfrica practice questions on the same concept. NEVER
  // repurposed for the CourseTopic hierarchy below - StudentTopicMastery
  // and the practice cross-link both key off this exact string.
  topic    String?

  // Optional curriculum-browse grouping (see CourseTopic above).
  courseTopic   CourseTopic? @relation(fields: [courseTopicId], references: [id])
  courseTopicId String?

  // Pre-recorded video metadata. All optional so TEXT/QUIZ-type lessons
  // (and any VIDEO lesson created before these fields existed) are unaffected.
  durationSeconds    Int?
  thumbnailUrl       String?
  captionsUrl        String?
  // "Title - Author, License", recorded for freely-licensed sourced clips.
  videoAttribution   String?
  // Whole-lesson fallback transcript when chapters aren't authored.
  transcriptFull     String?
  // The separate "Notes" tab - distinct from `content` (TEXT-lesson body /
  // quiz intro text, untouched) and from the transcript.
  notesMarkdown      String?
  learningObjectives String[] @default([])

  // Content-review workflow, reusing CourseModerationStatus rather than
  // inventing a third workflow enum (QuestionStatus is already shared by
  // Question + PassageGroup - same precedent). Existing lessons default to
  // PUBLISHED so nothing that already worked stops working; new lessons
  // are created explicitly as DRAFT by the authoring action, mirroring how
  // createQuestion() explicitly sets status: DRAFT despite the schema
  // default being the legacy-safe PUBLISHED.
  moderationStatus CourseModerationStatus @default(PUBLISHED)
  moderationReason String?
  moderatedById    String?
  moderatedAt      DateTime?

  progress      LessonProgress[]
  quizQuestions QuizQuestion[]
  chapters      LessonChapter[]

  relatedLessons Lesson[] @relation("RelatedLessons")
  relatedFrom    Lesson[] @relation("RelatedLessons")

  aiConversations AiConversation[]
}

// Timestamped video chapters with a chapter-aware transcript segment, so
// the AI tutor can ground itself in the material near the student's
// current playback position rather than drifting into unrelated content.
model LessonChapter {
  id                String   @id @default(cuid())
  lesson            Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId          String
  order             Int
  title             String
  startSeconds      Int
  // Null = "until the next chapter / end of video".
  endSeconds        Int?
  transcriptSegment String?
  createdAt         DateTime @default(now())

  checkpoints QuizQuestion[]

  @@unique([lessonId, order])
  @@index([lessonId])
}

model QuizQuestion {
  id            String @id @default(cuid())
  lesson        Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId      String
  order         Int
  prompt        String
  options       Json // [{ key: "A", text: "..." }, ...]
  correctOption String

  // When set, this row is an in-video interactive checkpoint that pauses
  // playback at this timestamp rather than an ordinary end-of-lesson quiz
  // item. Checkpoints only ever attach to VIDEO-type lessons; ordinary quiz
  // items only ever attach to QUIZ-type lessons - no collision in existing
  // quiz-rendering/grading code, which already branches on lesson.type.
  atSeconds   Int?
  explanation String?
  chapter     LessonChapter? @relation(fields: [chapterId], references: [id])
  chapterId   String?

  responses LessonCheckpointResponse[]
}

// Append-only, mirrors QuestionResponse's shape. Needed for: AI "recent
// checkpoint mistakes in this lesson" context, the wrong-answer "Watch This
// Part Again" flow (jump back to the relevant chapter/timestamp), and
// graded-attempt mastery recording for checkpoint answers.
model LessonCheckpointResponse {
  id             String       @id @default(cuid())
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  quizQuestion   QuizQuestion @relation(fields: [quizQuestionId], references: [id], onDelete: Cascade)
  quizQuestionId String
  selectedOption String
  isCorrect      Boolean
  answeredAt     DateTime     @default(now())

  @@index([userId, quizQuestionId])
}

enum EnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED
}

model CourseEnrollment {
  id          String           @id @default(cuid())
  user        User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  course      Course           @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId    String
  status      EnrollmentStatus @default(ACTIVE)
  enrolledAt  DateTime         @default(now())
  completedAt DateTime?

  lessonProgress LessonProgress[]

  @@unique([userId, courseId])
}

model LessonProgress {
  id           String           @id @default(cuid())
  enrollment   CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  enrollmentId String
  lesson       Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId     String
  completedAt  DateTime?
  // Set for QUIZ-type lessons: percentage score of the student's attempt.
  score        Float?

  // Video resume/watch tracking. percentWatched is a high-water-mark (max
  // reached so far) - it never regresses on rewatch or scrubbing backward.
  lastPositionSeconds Int?
  percentWatched      Float?
  lastWatchedAt       DateTime?

  @@unique([enrollmentId, lessonId])
}

model Assignment {
  id           String    @id @default(cuid())
  course       Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  title        String
  instructions String
  dueAt        DateTime?
  createdAt    DateTime  @default(now())

  submissions AssignmentSubmission[]
}

model AssignmentSubmission {
  id           String     @id @default(cuid())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  assignmentId String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  content      String
  submittedAt  DateTime   @default(now())
  grade        Float?
  feedback     String?
  gradedAt     DateTime?

  @@unique([assignmentId, userId])
}

model Certificate {
  id       String   @id @default(cuid())
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  course   Course   @relation(fields: [courseId], references: [id])
  courseId String
  issuedAt DateTime @default(now())
  certUrl  String?

  @@unique([userId, courseId])
}

model Badge {
  id          String  @id @default(cuid())
  name        String  @unique
  description String
  iconUrl     String?

  users UserBadge[]
}

model UserBadge {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  badge     Badge    @relation(fields: [badgeId], references: [id], onDelete: Cascade)
  badgeId   String
  awardedAt DateTime @default(now())

  @@unique([userId, badgeId])
}

// ---------- Commerce: subscriptions, payments, vouchers, referrals ----------

enum SubscriptionPlan {
  FREE
  BASIC
  PREMIUM
  PRO
  SCHOOL
}

enum SubscriptionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

// MONTHLY is the default for every existing row and every code path that
// doesn't yet pass an interval, so this is purely additive: nothing that
// already worked changes behavior.
enum BillingInterval {
  MONTHLY
  ANNUAL
}

model Subscription {
  id     String @id @default(cuid())
  // The person whose access this subscription grants (used everywhere
  // entitlement is checked). Equal to purchasedByUserId for self-purchases.
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Set when someone else paid for this subscription on the user's behalf
  // (e.g. a parent subscribing their child). Null means self-purchased.
  purchasedBy       User?   @relation("PurchasedSubscriptions", fields: [purchasedByUserId], references: [id])
  purchasedByUserId String?

  plan      SubscriptionPlan
  interval  BillingInterval    @default(MONTHLY)
  status    SubscriptionStatus @default(ACTIVE)
  startedAt DateTime           @default(now())
  expiresAt DateTime?

  payments Payment[]
}

enum PaymentStatus {
  PENDING
  SUCCESS
  FAILED
}

model Payment {
  id             String        @id @default(cuid())
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId         String
  subscription   Subscription? @relation(fields: [subscriptionId], references: [id])
  subscriptionId String?
  amountKobo     Int
  currency       String        @default("NGN")
  interval       BillingInterval @default(MONTHLY)
  provider       String
  reference      String        @unique
  status         PaymentStatus @default(PENDING)
  createdAt      DateTime      @default(now())

  // Permanent human-readable reference, e.g. TXN-000023456. Backfilled for
  // payments that existed before this field was added.
  transactionNumber String?     @unique
  kind              PaymentKind @default(CHARGE)
  // Set on a REFUND row: the original CHARGE row it reverses. Historical
  // charge rows are never edited in place — a refund is a new row.
  reversalOfId      String?

  @@index([userId])
  @@index([createdAt])
}

enum PaymentKind {
  CHARGE
  REFUND
}

enum VoucherStatus {
  ACTIVE
  REDEEMED
  EXPIRED
}

model SponsorshipProgram {
  id        String         @id @default(cuid())
  sponsor   SponsorProfile @relation(fields: [sponsorId], references: [id], onDelete: Cascade)
  sponsorId String

  name         String
  plan         SubscriptionPlan
  // When set, this program's seats are earmarked for one school; when
  // null, the codes can be redeemed by any student.
  school       School?          @relation(fields: [schoolId], references: [id])
  schoolId     String?
  // Informational targeting (e.g. "sponsor Mathematics learning") — does
  // not restrict what a redeemed seat grants, which is always the plan.
  subject      Subject?         @relation(fields: [subjectId], references: [id])
  subjectId    String?
  totalSeats   Int
  durationDays Int
  createdAt    DateTime         @default(now())

  vouchers Voucher[]
}

model Voucher {
  id         String              @id @default(cuid())
  code       String              @unique
  sponsor    SponsorProfile?     @relation(fields: [sponsorId], references: [id])
  sponsorId  String?
  program    SponsorshipProgram? @relation(fields: [programId], references: [id])
  programId  String?
  issuedBy   User                @relation("VoucherIssuer", fields: [issuedById], references: [id])
  issuedById String
  plan       SubscriptionPlan
  status     VoucherStatus       @default(ACTIVE)
  expiresAt  DateTime?
  createdAt  DateTime            @default(now())

  redemption VoucherRedemption?
}

model VoucherRedemption {
  id         String   @id @default(cuid())
  voucher    Voucher  @relation(fields: [voucherId], references: [id], onDelete: Cascade)
  voucherId  String   @unique
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  redeemedAt DateTime @default(now())
}

enum ReferralStatus {
  PENDING
  REWARDED
}

model Referral {
  id             String         @id @default(cuid())
  referrer       User           @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)
  referrerId     String
  referredUser   User?          @relation("Referred", fields: [referredUserId], references: [id])
  referredUserId String?        @unique
  code           String         @unique
  status         ReferralStatus @default(PENDING)
  createdAt      DateTime       @default(now())
}

// ---------- AI Study Coach ----------

enum AiCoachMode {
  ASK
  EXPLAIN
  PRACTICE
  QUIZ_ME
  STUDY_PLAN
  EXAM_PREP
}

enum AiMessageRole {
  USER
  ASSISTANT
  SYSTEM
}

model AiConversation {
  id     String @id @default(cuid())
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String

  // Context the conversation was launched from — all optional, since a
  // conversation started from the dashboard has no course/lesson yet.
  course    Course?  @relation(fields: [courseId], references: [id])
  courseId  String?
  lesson    Lesson?  @relation(fields: [lessonId], references: [id])
  lessonId  String?
  subject   Subject? @relation(fields: [subjectId], references: [id])
  subjectId String?

  mode      AiCoachMode @default(ASK)
  // Auto-generated from the first exchange (e.g. "Quadratic Equation Help"),
  // never a placeholder like "New Chat 1".
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  messages AiMessage[]

  @@index([userId, updatedAt])
}

model AiMessage {
  id             String         @id @default(cuid())
  conversation   AiConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  conversationId String
  role           AiMessageRole
  content        String
  // Freeform extras: quick-action used, source question/attempt id for a
  // "why was this wrong" prompt, thumbs rating, etc. Never the full lesson
  // text or other bulky context — only small pointers.
  metadata       Json?
  createdAt      DateTime       @default(now())

  @@index([conversationId, createdAt])
}

model StudentTopicMastery {
  id        String  @id @default(cuid())
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  subject   Subject @relation(fields: [subjectId], references: [id])
  subjectId String
  // Plain string, matching the existing Question.topic / Lesson.topic
  // convention rather than introducing a new normalized Topic entity.
  topic     String

  // 0-100 estimate of how well the student knows this topic.
  masteryScore    Float @default(0)
  // 0-1 estimate of how reliable masteryScore is (grows with attempts).
  confidenceScore Float @default(0)

  questionsAttempted Int       @default(0)
  questionsCorrect   Int       @default(0)
  lastPracticedAt    DateTime?
  updatedAt          DateTime  @updatedAt

  @@unique([userId, subjectId, topic])
  @@index([userId, masteryScore])
}

enum AiInsightType {
  WEAK_TOPIC
  STRONG_TOPIC
  COMMON_MISTAKE
  RECOMMENDED_TOPIC
  READINESS_SUMMARY
}

model AiLearningInsight {
  id          String        @id @default(cuid())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  subject     Subject?      @relation(fields: [subjectId], references: [id])
  subjectId   String?
  topic       String?
  insightType AiInsightType
  insight     String
  confidence  Float         @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([userId, insightType])
}

model AiUsageLog {
  id                String   @id @default(cuid())
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  // e.g. "coach_chat", "practice_generate", "mistake_explain"
  feature           String
  model             String
  inputTokens       Int      @default(0)
  outputTokens      Int      @default(0)
  // Rough estimate, in kobo, for admin cost visibility — not a billing record.
  estimatedCostKobo Int      @default(0)
  createdAt         DateTime @default(now())

  @@index([userId, createdAt])
  @@index([createdAt])
}

// Per-plan daily AI message allowance, editable by platform admins.
model AiPlanLimit {
  plan              SubscriptionPlan @id
  dailyMessageLimit Int
  // Additive: the daily column is kept in place (no destructive migration)
  // but is no longer read once usage checks moved to a monthly window.
  monthlyMessageLimit Int?
  updatedAt         DateTime         @updatedAt
}

// ---------- Partner / Affiliate Program ----------

enum PartnerType {
  INDIVIDUAL_AFFILIATE
  TEACHER
  EDUCATION_CONSULTANT
  SCHOOL_REPRESENTATIVE
  INFLUENCER
  COMMUNITY_AMBASSADOR
  CORPORATE_NGO
  MARKETING_AGENCY
  OTHER
}

enum PartnerStatus {
  PENDING
  APPROVED
  SUSPENDED
  REJECTED
  CLOSED
}

model Partner {
  id            String  @id @default(cuid())
  // Permanent, human-readable, never reused — e.g. EDP-00001245. Assigned
  // only at approval time (pending applicants don't have one yet). The
  // cuid above stays the actual FK/primary key everywhere else.
  partnerNumber String? @unique
  // Same value with no punctuation, used in ?ref= URLs (EDP00001245).
  referralCode  String? @unique

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId String @unique

  firstName    String
  lastName     String
  phone        String
  country      String      @default("Nigeria")
  // Relational counterpart to the free-text `country` string above — same
  // additive/backfilled pattern as School.countryRef.
  countryRef   Country?    @relation(fields: [countryId], references: [id])
  countryId    String?
  state        String?
  city         String?
  organization String?
  partnerType  PartnerType

  status          PartnerStatus @default(PENDING)
  approvedAt      DateTime?
  approvedById    String?
  rejectedReason  String?
  suspendedReason String?
  adminNotes      String?

  preferredPaymentMethod String? // BANK_TRANSFER | PAYSTACK | OTHER
  bankName               String?
  bankAccountName        String?
  bankAccountNumber      String?

  promotionPlan   String? // "how they plan to promote Educom"
  referralSource  String? // how they heard about the program
  termsAcceptedAt DateTime?

  // Opts a partner out of the public leaderboard (admin can also disable it
  // platform-wide via PartnerSettings).
  hideFromLeaderboard Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  campaigns            PartnerCampaign[]
  referrals            PartnerReferral[]
  schoolLeads          PartnerSchoolLead[]
  schoolAttributions   PartnerSchoolAttribution[]
  commissions          PartnerCommission[]
  payouts              PartnerPayout[]
  notifications        PartnerNotification[]
  fraudFlags           PartnerFraudFlag[]
  referredUsers        User[]                     @relation("PartnerReferredUsers")
  disputesAsIncumbent  PartnerSchoolDispute[]     @relation("DisputeIncumbent")
  disputesAsChallenger PartnerSchoolDispute[]     @relation("DisputeChallenger")

  @@index([status])
}

model PartnerCampaign {
  id        String  @id @default(cuid())
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  slug String // used in ?campaign=lagos-schools
  name String

  createdAt DateTime @default(now())

  referrals     PartnerReferral[]
  referredUsers User[]

  @@unique([partnerId, slug])
}

enum PartnerReferralStatus {
  CLICKED
  REGISTERED
  FLAGGED
}

// One row per distinct link click — clicks are never counted as students.
// A click optionally graduates to a registered user (userId set) and,
// separately, may correlate to a school lead when the click came from a
// partner's school-invitation flow.
model PartnerReferral {
  id        String  @id @default(cuid())
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  campaign   PartnerCampaign? @relation(fields: [campaignId], references: [id])
  campaignId String?

  // Opaque token carried through the URL/hidden form field as a fallback so
  // attribution does not depend solely on cookies (see attribution.ts).
  clickToken String @unique

  landingPage String?
  // "STUDENT" | "SCHOOL" — which registration flow the click was aimed at.
  intent      String?
  ipHash      String? // hashed, never the raw IP
  userAgent   String?

  clickedAt    DateTime  @default(now())
  registeredAt DateTime?

  user   User?   @relation("ReferralClickUser", fields: [userId], references: [id])
  userId String? @unique

  schoolLead   PartnerSchoolLead? @relation(fields: [schoolLeadId], references: [id])
  schoolLeadId String?

  status        PartnerReferralStatus @default(CLICKED)
  flaggedReason String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, createdAt])
  @@index([clickToken])
}

enum SchoolLeadStatus {
  NEW_LEAD
  CONTACTED
  DEMO_SCHEDULED
  NEGOTIATING
  SCHOOL_REGISTERED
  ACTIVATED
  PAYING_SCHOOL
  LOST
}

model PartnerSchoolLead {
  id         String  @id @default(cuid())
  leadNumber String  @unique // SCH-LEAD-000234
  partner    Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId  String

  schoolName        String
  contactName       String
  phone             String
  email             String?
  state             String?
  city              String?
  estimatedStudents Int?
  estimatedTeachers Int?
  notes             String?

  status SchoolLeadStatus @default(NEW_LEAD)

  // Set once this lead's school actually registers on the platform.
  // Preserved permanently — a later click from a different partner never
  // overwrites it (see PartnerSchoolAttribution for dispute handling).
  school   School? @relation(fields: [schoolId], references: [id])
  schoolId String?

  invitationToken     String?   @unique
  invitationExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  statusHistory       PartnerSchoolLeadStatusChange[]
  referralClicks      PartnerReferral[]
  attributionsWon     PartnerSchoolAttribution[]      @relation("WinningLead")
  disputeAsChallenger PartnerSchoolDispute?

  @@index([partnerId, status])
  @@index([schoolId])
}

model PartnerSchoolLeadStatusChange {
  id          String            @id @default(cuid())
  lead        PartnerSchoolLead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  leadId      String
  fromStatus  SchoolLeadStatus?
  toStatus    SchoolLeadStatus
  changedById String?
  note        String?
  createdAt   DateTime          @default(now())

  @@index([leadId])
}

// The single authoritative "who gets school-referral credit" record for a
// school. Created from the first lead that reaches SCHOOL_REGISTERED;
// competing leads from other partners remain on file (never deleted) and
// can only be reassigned here by an explicit, audit-logged admin decision.
model PartnerSchoolAttribution {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String @unique

  partner   Partner @relation(fields: [partnerId], references: [id])
  partnerId String

  winningLead   PartnerSchoolLead? @relation("WinningLead", fields: [winningLeadId], references: [id])
  winningLeadId String?

  decidedById  String?
  decisionNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum DisputeStatus {
  OPEN
  RESOLVED_INCUMBENT
  RESOLVED_CHALLENGER
  DISMISSED
}

// Raised automatically when a second partner's lead reaches
// SCHOOL_REGISTERED for a school that already has a PartnerSchoolAttribution
// from a different partner. The incumbent attribution is never silently
// overwritten — only an admin decision (recorded here) can change it.
model PartnerSchoolDispute {
  id       String @id @default(cuid())
  school   School @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId String

  challengerLead   PartnerSchoolLead @relation(fields: [challengerLeadId], references: [id])
  challengerLeadId String            @unique

  incumbentPartner    Partner @relation("DisputeIncumbent", fields: [incumbentPartnerId], references: [id])
  incumbentPartnerId  String
  challengerPartner   Partner @relation("DisputeChallenger", fields: [challengerPartnerId], references: [id])
  challengerPartnerId String

  status       DisputeStatus @default(OPEN)
  resolution   String?
  resolvedById String?
  resolvedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([schoolId, status])
}

enum CommissionEventType {
  STUDENT_FIRST_SUBSCRIPTION
  STUDENT_RECURRING_SUBSCRIPTION
  SCHOOL_ACTIVATION
  SCHOOL_STUDENT_ACTIVATION
  CAMPAIGN_BONUS
  MILESTONE_BONUS
}

enum CommissionCalcType {
  FIXED
  PERCENTAGE
}

// A versioned compensation rule. Editing a rule NEVER mutates an existing
// row — it creates a new row with version+1 and flips the previous version's
// isActive to false. Every PartnerCommission points at the exact rule
// version that produced it, so past commissions are structurally immune to
// later admin rate changes.
model PartnerCommissionRule {
  id       String  @id @default(cuid())
  ruleKey  String // stable id grouping versions, e.g. "student_first_subscription"
  version  Int
  isActive Boolean @default(true)

  name        String
  description String?

  eventType CommissionEventType
  calcType  CommissionCalcType

  fixedAmountKobo Int?
  percentage      Float? // 10 == 10%
  isRecurring     Boolean @default(false)
  recurringMonths Int?

  // Optional tiered brackets overriding the flat fixed/percentage above:
  // [{ "minCount": 0, "maxCount": 100, "amountKobo": 50000 }, ...]
  tierBrackets Json?

  maxAmountKobo         Int? // optional cap (e.g. per-school student bonus cap)
  qualificationHoldDays Int  @default(14)

  createdById String?
  createdAt   DateTime @default(now())

  commissions PartnerCommission[]

  @@unique([ruleKey, version])
  @@index([ruleKey, isActive])
}

enum CommissionStatus {
  PENDING
  QUALIFIED
  APPROVED
  AVAILABLE
  PAID
  REVERSED
  CANCELLED
}

model PartnerCommission {
  id               String @id @default(cuid())
  commissionNumber String @unique // COM-0009342

  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  rule   PartnerCommissionRule @relation(fields: [ruleId], references: [id])
  ruleId String

  eventType CommissionEventType

  // Internal references only — never resolved to PII beyond what the
  // partner is already entitled to see in their own referral tables.
  sourceUser           User?   @relation("CommissionSourceUser", fields: [sourceUserId], references: [id])
  sourceUserId         String?
  sourceSchoolId       String?
  sourcePaymentId      String?
  sourceSubscriptionId String?
  sourceSchoolLeadId   String?

  // Immutable once created — status/timestamps change, this does not.
  amountKobo Int
  status     CommissionStatus @default(PENDING)

  qualifiesAt    DateTime? // hold-period expiry; auto-qualify after this
  qualifiedAt    DateTime?
  approvedAt     DateTime?
  availableAt    DateTime?
  paidAt         DateTime?
  reversedAt     DateTime?
  reversalReason String?

  payout   PartnerPayout? @relation(fields: [payoutId], references: [id])
  payoutId String?

  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([partnerId, status])
  @@index([sourcePaymentId])
  @@index([qualifiesAt])
}

enum PayoutStatus {
  REQUESTED
  APPROVED
  PAID
  REJECTED
  CANCELLED
}

model PartnerPayout {
  id           String  @id @default(cuid())
  payoutNumber String  @unique // PAY-000123
  partner      Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId    String

  amountKobo          Int
  method              String // BANK_TRANSFER | PAYSTACK | OTHER
  destinationSnapshot Json? // bank details as they were at request time

  status         PayoutStatus @default(REQUESTED)
  requestedAt    DateTime     @default(now())
  approvedAt     DateTime?
  approvedById   String?
  paidAt         DateTime?
  rejectedReason String?
  adminNotes     String?

  commissions PartnerCommission[]

  @@index([partnerId, status])
}

// Admin-configurable tier thresholds — tier is always computed live from a
// partner's current qualified-paid-student count against these rows, never
// stored on Partner, so changing a threshold never leaves stale data.
model PartnerTier {
  id              String  @id @default(cuid())
  name            String  @unique
  minPaidStudents Int
  sortOrder       Int
  perks           String?
  bonusPercentage Float   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum MarketingAssetType {
  LOGO
  BANNER
  SOCIAL_GRAPHIC
  WHATSAPP_GRAPHIC
  BROCHURE
  FLYER
  QR_CODE
  SAMPLE_MESSAGE
  VIDEO
  OTHER
}

model PartnerMarketingAsset {
  id          String             @id @default(cuid())
  title       String
  description String?
  assetType   MarketingAssetType
  url         String?
  content     String? // for SAMPLE_MESSAGE — the actual suggested text
  isPublished Boolean            @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------- Unified Admin Portal: audit trail & login activity ----------
// General-purpose complement to PartnerAuditLog (which stays scoped to the
// Partner program). The Audit Log viewer reads from both tables.

model AuditLog {
  id          String  @id @default(cuid())
  actor       User?   @relation("AdminAuditActor", fields: [actorUserId], references: [id])
  actorUserId String?
  actorRole   Role?

  action       String // e.g. "QUESTION_PUBLISHED", "USER_SUSPENDED", "ADMIN_ROLE_CHANGED"
  resourceType String // e.g. "Question", "User", "School", "Payment"
  resourceId   String?
  result       String // "SUCCESS" | "DENIED" | "FAILURE"

  before Json?
  after  Json?

  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([resourceType, resourceId])
  @@index([actorUserId])
  @@index([createdAt])
}

model LoginActivity {
  id     String  @id @default(cuid())
  user   User?   @relation("LoginActivityUser", fields: [userId], references: [id])
  userId String?
  email  String

  success       Boolean
  failureReason String?

  ipHash    String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([createdAt])
}

model PartnerAuditLog {
  id          String  @id @default(cuid())
  actor       User?   @relation("AuditActor", fields: [actorUserId], references: [id])
  actorUserId String?

  action     String // e.g. "PARTNER_APPROVED", "SCHOOL_ATTRIBUTION_REASSIGNED"
  entityType String
  entityId   String
  metadata   Json?

  createdAt DateTime @default(now())

  @@index([entityType, entityId])
}

enum PartnerNotificationType {
  APPLICATION_APPROVED
  NEW_STUDENT
  SCHOOL_LEAD_STATUS_CHANGED
  SCHOOL_ACTIVATED
  COMMISSION_EARNED
  COMMISSION_AVAILABLE
  PAYOUT_APPROVED
  PAYOUT_COMPLETED
  TIER_UPGRADED
}

// General-purpose in-app notification, parallel to the Partner-scoped
// PartnerNotification below (same shape, kept separate since that one is
// wired to PartnerNotificationType-specific partner events). `type` is a
// free-text tag (e.g. "MOCK_EXAM_COMPLETED", "ASSIGNMENT_SUBMITTED") rather
// than an enum, since this model spans every role's very different event
// vocabulary — same convention already used by AuditLog.action.
model Notification {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      String
  message   String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, readAt])
}

model PartnerNotification {
  id        String                  @id @default(cuid())
  partner   Partner                 @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String
  type      PartnerNotificationType
  message   String
  readAt    DateTime?
  createdAt DateTime                @default(now())

  @@index([partnerId, readAt])
}

enum FraudFlagStatus {
  OPEN
  REVIEWING
  CONFIRMED
  DISMISSED
}

model PartnerFraudFlag {
  id        String  @id @default(cuid())
  partner   Partner @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  partnerId String

  reason              String // SELF_REFERRAL | DUPLICATE_ACCOUNT | ...
  details             String?
  relatedReferralId   String?
  relatedCommissionId String?

  status       FraudFlagStatus @default(OPEN)
  reviewedById String?
  reviewNote   String?

  createdAt  DateTime  @default(now())
  resolvedAt DateTime?

  @@index([partnerId, status])
}

// Singleton config row (id is always 1) — attribution window, payout
// minimum, and program-wide toggles, editable by admins without a deploy.
model PartnerSettings {
  id                    Int      @id @default(1)
  attributionWindowDays Int      @default(30)
  minimumPayoutKobo     Int      @default(1000000) // ₦10,000
  requireAdminApproval  Boolean  @default(true)
  leaderboardEnabled    Boolean  @default(true)
  updatedAt             DateTime @updatedAt
}

// ---------- Branding, Legal & Support ----------

// Singleton config row (id is always 1) — official support contact details.
// All fields are nullable and stay null until an admin actually configures
// them; pages must never display a fabricated address/phone/email.
model PlatformSettings {
  id               Int      @id @default(1)
  companyLegalName String?
  supportEmail     String?
  supportPhone     String?
  companyAddress   String?
  supportHours     String?
  updatedAt        DateTime @updatedAt
}

enum LegalDocumentType {
  TERMS
  PRIVACY
  PARTNER_PROGRAM
}

// A versioned legal document. Editing NEVER mutates an existing row — it
// creates version+1 and flips the previous version's isActive to false, so
// a LegalAcceptance always points at the exact text a user agreed to,
// immune to later edits. Mirrors PartnerCommissionRule's versioning.
model LegalDocument {
  id          String            @id @default(cuid())
  type        LegalDocumentType
  version     Int
  isActive    Boolean           @default(true)
  title       String
  content     String // Markdown
  effectiveAt DateTime          @default(now())
  createdById String?
  createdAt   DateTime          @default(now())

  acceptances LegalAcceptance[]

  @@unique([type, version])
  @@index([type, isActive])
}

// Audit trail of who accepted which exact document version, when, in what
// context, and (where legally permitted) from which hashed IP — never the
// raw IP. Rows are never updated or deleted once created.
model LegalAcceptance {
  id         String        @id @default(cuid())
  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId     String?
  document   LegalDocument @relation(fields: [documentId], references: [id])
  documentId String
  context    String // "REGISTRATION" | "PARTNER_APPLICATION"
  ipHash     String?
  createdAt  DateTime      @default(now())

  @@index([userId])
  @@index([documentId])
}

enum ContactAccountType {
  STUDENT
  PARENT
  TEACHER
  SCHOOL
  SPONSOR
  PARTNER
  OTHER
}

enum ContactTopic {
  GENERAL_INQUIRY
  ACCOUNT_SUPPORT
  BILLING
  COURSE_SUPPORT
  SCHOOL_REGISTRATION
  PARTNER_PROGRAM
  AI_STUDY_COACH
  TECHNICAL_PROBLEM
  REPORT_ISSUE
  OTHER
}

enum ContactStatus {
  NEW
  IN_REVIEW
  RESPONDED
  RESOLVED
  CLOSED
}

model ContactSubmission {
  id          String             @id @default(cuid())
  firstName   String
  lastName    String
  email       String
  phone       String?
  accountType ContactAccountType
  topic       ContactTopic
  message     String

  user   User?   @relation("ContactSubmitter", fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  status       ContactStatus @default(NEW)
  assignedTo   User?         @relation("ContactAssignee", fields: [assignedToId], references: [id])
  assignedToId String?

  ipHash    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Permanent human-readable reference, e.g. SUP-000432. Backfilled for
  // submissions that existed before this field was added.
  submissionNumber String? @unique

  @@index([status, createdAt])
  @@index([ipHash, createdAt])
}

// ---------- International Exams: TOEFL ----------
// Phase 1 (foundation only): flag + config + landing/dashboard. TOEFL is
// intentionally NOT modeled as an ExamType/Question/ExamAttempt — those
// are MCQ-only and scoped to Nigerian exam bodies. TOEFL needs skills,
// task types, audio, and free-text answers, so it gets its own additive
// namespace instead of distorting the existing exam schema. No existing
// model, enum, or field is touched by this section.

enum ToeflSkill {
  READING
  LISTENING
  SPEAKING
  WRITING
}

enum ToeflAttemptKind {
  DIAGNOSTIC
  SKILL_PRACTICE
  MOCK_EXAM
}

enum ToeflEvalStatus {
  NOT_APPLICABLE // reading/listening MCQ items — no evaluation ever applies
  NOT_EVALUATED
  EVALUATING
  EVALUATED
  FAILED
  UNAVAILABLE // AI scoring not configured yet
}

// A shared passage/audio stimulus that multiple ToeflContent questions
// attach to (e.g. one Reading passage or Listening lecture with several
// questions) — mirrors PassageGroup's shape/role for WAEC/UTME exactly,
// including reusing QuestionStatus/QuestionSourceType so the same admin
// review workflow applies. One passage/audio per set, matching how TOEFL
// content sets are structured today (a future multi-clip listening set
// is a deliberate out-of-scope case, not built speculatively).
model ToeflContentSet {
  id         String @id @default(cuid())
  skill      ToeflSkill
  externalId String? // human-readable set code from bulk import, e.g. "TOEFL-R-001"

  passageTitle     String?
  passage          String?
  audioUrl         String?
  audioDurationSec Float?
  transcript       String?
  imageUrl         String?

  status     QuestionStatus     @default(DRAFT)
  sourceType QuestionSourceType @default(ORIGINAL_SMARTPREP_QUESTION)
  author         String?
  license        String?
  sourceReference String?
  createdByAi    Boolean            @default(false)
  reviewedById   String?

  // Set when this row was created by a bulk import batch — lets a
  // rollback remove exactly (and only) the rows that batch created.
  importBatchId String?

  createdById String?
  createdAt   DateTime @default(now())

  content ToeflContent[]

  @@unique([skill, externalId])
  @@index([status])
  @@index([importBatchId])
}

// No rows are created by Phase 1 — this model exists now so later
// phases (Reading/Listening/Writing/Speaking) extend rather than
// redesign it, and so the dashboard's real (empty) queries compile today.
model ToeflContent {
  id         String         @id @default(cuid())
  skill      ToeflSkill
  // Free text like Question.topic/subtopic, not an enum — new task types
  // (e.g. "READING_MCQ", "SPEAKING_INDEPENDENT") never need a migration.
  taskType   String
  difficulty Difficulty     @default(MEDIUM) // reuses the existing Question enum
  status     QuestionStatus @default(DRAFT) // reuses the existing Question workflow

  // Human-readable id from bulk import (the spec's "question_id"),
  // distinct from the internal cuid `id`. Nullable-safe unique index —
  // Postgres allows multiple NULLs, so hand-created content is unaffected.
  externalId String?

  // Optional membership in a shared ToeflContentSet (passage/audio),
  // same nullable/additive FK pattern as Question.passageGroupId.
  contentSet   ToeflContentSet? @relation(fields: [contentSetId], references: [id])
  contentSetId String?
  order        Int?

  passage          String?
  audioUrl         String?
  audioDurationSec Float?
  transcript       String?
  prompt           String
  options          Json?
  correctOption    String?
  explanation      String?
  estimatedTimeSec Int?
  tags             String[] @default([])

  // Content-safety / copyright metadata (spec section 10).
  sourceType      QuestionSourceType @default(ORIGINAL_SMARTPREP_QUESTION)
  author          String?
  license         String?
  sourceReference String?
  createdByAi     Boolean            @default(false)
  reviewedById    String?

  // Set when this row was created by a bulk import batch.
  importBatchId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attemptItems ToeflAttemptItem[]

  @@unique([skill, externalId])
  @@index([skill, status])
  @@index([taskType])
  @@index([difficulty])
  @@index([contentSetId])
  @@index([importBatchId])
}

model ToeflAttempt {
  id     String           @id @default(cuid())
  user   User             @relation(fields: [userId], references: [id])
  userId String
  kind   ToeflAttemptKind
  skill  ToeflSkill? // null for a full mock covering all 4 skills

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  overallScore   Float? // 0-6 scale estimate
  readingScore   Float?
  listeningScore Float?
  speakingScore  Float?
  writingScore   Float?

  items ToeflAttemptItem[]

  @@index([userId, kind])
}

model ToeflAttemptItem {
  id        String       @id @default(cuid())
  attempt   ToeflAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId String
  content   ToeflContent @relation(fields: [contentId], references: [id])
  contentId String
  order     Int          @default(0)

  // Reading/Listening (MCQ)
  selectedOption String?
  isCorrect      Boolean?
  timeSpentSecs  Int?

  // Speaking
  speakingAudioUrl    String?
  speakingDurationSec Float?

  // Writing
  writingText      String?
  writingWordCount Int?

  // Shared AI-evaluation result (speaking + writing)
  evalStatus         ToeflEvalStatus @default(NOT_APPLICABLE)
  evalScore          Float?
  evalFluency        Float?
  evalPronunciation  Float?
  evalGrammar        Float?
  evalVocabulary     Float?
  evalTaskCompletion Float?
  evalOrganization   Float?
  evalClarity        Float?
  evalFeedback       String?

  @@unique([attemptId, contentId])
}

// ---------- Digital SAT (additive module, mirrors the Toefl* models
// above — its own bespoke content/attempt models rather than reusing
// Question/ExamAttempt, which are hard-typed to the closed ExamType
// enum and have no room for SAT's two-section/module shape). ----------

enum SatSection {
  READING_WRITING
  MATH
}

enum SatAttemptKind {
  SKILL_PRACTICE
  DIAGNOSTIC
  MOCK_EXAM
}

// A shared Reading & Writing passage that multiple SatContent questions
// attach to — same role as ToeflContentSet/PassageGroup. SAT R&W is
// usually 1 passage : 1 question, but this exists so a shared passage
// is representable when the source content has one, without duplicating
// the passage text on every row.
model SatContentSet {
  id         String     @id @default(cuid())
  section    SatSection
  externalId String? // human-readable set code from bulk import

  passageTitle String?
  passage      String?
  imageUrl     String?

  status     QuestionStatus     @default(DRAFT)
  sourceType QuestionSourceType @default(ORIGINAL_SMARTPREP_QUESTION)
  author          String?
  license         String?
  sourceReference String?
  createdByAi     Boolean            @default(false)
  reviewedById    String?

  importBatchId String?

  createdById String?
  createdAt   DateTime @default(now())

  content SatContent[]

  @@unique([section, externalId])
  @@index([status])
  @@index([importBatchId])
}

model SatContent {
  id           String         @id @default(cuid())
  section      SatSection
  domain       String // e.g. "Algebra", "Information and Ideas" — free text, not an enum, so new domains never need a migration
  skill        String?
  questionType String         @default("MULTIPLE_CHOICE") // "MULTIPLE_CHOICE" | "STUDENT_PRODUCED_RESPONSE"
  difficulty   Difficulty     @default(MEDIUM) // reuses the existing Question enum
  status       QuestionStatus @default(DRAFT) // reuses the existing Question workflow

  // Human-readable id from bulk import, distinct from the internal cuid.
  externalId String?

  contentSet   SatContentSet? @relation(fields: [contentSetId], references: [id])
  contentSetId String?
  order        Int?

  passage          String? // short Reading & Writing passage/text
  imageUrl         String? // SAT Math graphics/charts/diagrams
  prompt           String
  options          Json? // MCQ options; null for numeric-response items
  correctOption    String?
  correctValue     String? // numeric/grid-in expected answer
  explanation      String?
  calculatorAllowed Boolean?
  estimatedTimeSec Int?
  tags             String[] @default([])

  // Content-safety / copyright metadata (spec section 10).
  sourceType      QuestionSourceType @default(ORIGINAL_SMARTPREP_QUESTION)
  author          String?
  license         String?
  sourceReference String?
  createdByAi     Boolean            @default(false)
  reviewedById    String?

  importBatchId String?

  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attemptItems SatAttemptItem[]

  @@unique([section, externalId])
  @@index([section, status])
  @@index([domain])
  @@index([skill])
  @@index([difficulty])
  @@index([questionType])
  @@index([contentSetId])
  @@index([importBatchId])
}

model SatAttempt {
  id     String         @id @default(cuid())
  user   User           @relation(fields: [userId], references: [id])
  userId String
  kind   SatAttemptKind
  section SatSection? // null reserved for a future cross-section Diagnostic/Mock; set for skill practice

  startedAt   DateTime  @default(now())
  submittedAt DateTime?

  overallScore        Int? // 400-1600 composite — future Diagnostic/Mock use
  readingWritingScore Int? // 200-800
  mathScore           Int? // 200-800

  // Which Module 2 difficulty tier the adaptive router selected, per
  // section — "EASIER" | "HARDER" — set only for MOCK_EXAM attempts,
  // once that section's Module 1 has been scored. Null until then.
  readingWritingModule2Tier String?
  mathModule2Tier            String?

  // Set each time a new Mock Exam module begins (attempt creation, R&W
  // Module 2 routing, the Math-section break ending, Math Module 2
  // routing) so the countdown survives a refresh/disconnect — the
  // session page computes remaining time from this timestamp server-side
  // rather than trusting client-side countdown state, which resets to
  // full time on every reload. Unused for Skill Practice/Diagnostic,
  // which have no countdown.
  currentModuleStartedAt DateTime?

  items SatAttemptItem[]

  @@index([userId, kind])
}

model SatAttemptItem {
  id        String     @id @default(cuid())
  attempt   SatAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  attemptId String
  content   SatContent @relation(fields: [contentId], references: [id])
  contentId String
  order     Int        @default(0)
  module    Int? // 1 or 2, null for skill practice — added now, unused until the Module step, so that step needs no migration

  selectedOption String?
  numericAnswer  String?
  isCorrect      Boolean?
  timeSpentSecs  Int?
  flagged        Boolean @default(false)

  @@unique([attemptId, contentId])
}

/** One goal per student — target composite score and, optionally, a
 * test date. Purely informational (current vs. target, days
 * remaining): spec explicitly forbids promising a particular score
 * improvement, so no projection/trend logic lives here. */
model SatScoreGoal {
  id          String    @id @default(cuid())
  user        User      @relation(fields: [userId], references: [id])
  userId      String    @unique
  targetScore Int
  testDate    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

enum InternationalExamProduct {
  TOEFL
  SAT
}

/** A one-time purchase of TOEFL or SAT prep — deliberately its own model
 * rather than a SubscriptionPlan value: these are one-time products, not
 * recurring monthly plans, and must stay fully separate from the existing
 * Premium/Basic subscription pricing and payment pipeline. Mirrors
 * Payment's shape (reference/status/amountKobo) closely enough to reuse
 * the same low-level Paystack initialize/verify calls, but activation,
 * the webhook branch, and the callback route are all additive — nothing
 * about the existing Subscription/Payment flow is touched. */
model InternationalExamPurchase {
  id         String                    @id @default(cuid())
  user       User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  product    InternationalExamProduct
  amountKobo Int
  currency   String                    @default("NGN")
  provider   String                    @default("paystack")
  reference  String                    @unique
  status     PaymentStatus             @default(PENDING)
  createdAt  DateTime                  @default(now())
  paidAt     DateTime?

  @@index([userId, product])
}

// ---------- SAT/TOEFL bulk question import ----------
// Fully additive: no existing model touched. Content rows created by an
// import carry importBatchId directly (see SatContent/ToeflContent/
// SatContentSet/ToeflContentSet above), so rollback is a plain
// deleteMany({ where: { importBatchId } }) per table — no join table.

enum ContentImportFormat {
  CSV
  XLSX
  JSON
}

enum ContentImportStatus {
  UPLOADED
  VALIDATING
  VALIDATED
  IMPORTING
  COMPLETED
  FAILED
  ROLLED_BACK
}

enum ContentImportRowStatus {
  PENDING // parsed, not yet validated
  VALID
  WARNING
  ERROR
  DUPLICATE
  IMPORTED
}

model ContentImportBatch {
  id       String                    @id @default(cuid())
  exam     InternationalExamProduct
  format   ContentImportFormat
  filename String
  status   ContentImportStatus       @default(UPLOADED)

  totalRecords      Int @default(0)
  validRecords      Int @default(0)
  warningRecords    Int @default(0)
  errorRecords      Int @default(0)
  duplicateRecords  Int @default(0)
  importedRecords   Int @default(0)

  createdById String
  createdAt   DateTime  @default(now())
  rolledBackAt DateTime?

  rows ContentImportRow[]

  @@index([exam, status])
  @@index([createdAt])
}

// One row per parsed record. rawData is only kept for rows that still
// need admin attention (ERROR/WARNING/DUPLICATE) — a VALID row that gets
// imported becomes a real SatContent/ToeflContent row, so keeping a
// second copy of its data here would be pure bloat at 100k+ scale.
model ContentImportRow {
  id        String              @id @default(cuid())
  batch     ContentImportBatch  @relation(fields: [batchId], references: [id], onDelete: Cascade)
  batchId   String
  rowNumber Int
  status    ContentImportRowStatus @default(PENDING)
  messages  String[]            @default([])
  rawData   Json?
  // Set once this row has been imported, pointing at the real content row
  // (SatContent.id or ToeflContent.id depending on the batch's exam).
  contentId String?

  @@index([batchId, status])
  @@index([batchId, rowNumber])
}
